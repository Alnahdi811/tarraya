# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Never include local credentials, runtime logs or generated verification copies
**/.env
**/.env.*
!**/.env.example
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.dump
**/*.sql.gz
**/logs/
**/backups/
generated-artifacts/
test-results/
playwright-report/
data/private/
