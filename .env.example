# Copy to .env for the standalone local run only. Never commit .env.
# Supply an existing, empty PostgreSQL database and your own local credentials.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/tarraya
PORT=8080
BASE_PATH=/
SERVE_WEB=1
NODE_ENV=production

# Optional Replit-managed OpenAI integration.
# Leave both empty for deterministic domain checks plus an explicit AI-unavailable
# message when text is supplied. Do not put provider credentials in this template.
# In Replit, use the managed integration/Secrets instead of sourcing this file.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# Optional experimental WhatsApp integration. Leave all blank for the web demo.
# Use your Sandbox account's AC... SID and Auth Token, not an API Key Secret.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Sandbox sender, with country code: whatsapp:+YOUR_SANDBOX_NUMBER
TWILIO_WHATSAPP_FROM=
# Set to your actual published HTTPS URL + /api/whatsapp; never the dev preview.
TWILIO_WEBHOOK_URL=
